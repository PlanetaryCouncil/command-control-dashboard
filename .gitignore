# Any venv, not just the one we happened to name first. `.venv311` was
# committed once - 2260 files - and git tracked its lib/ without its bin/, so
# restoring it produced a virtualenv with libraries and no interpreter. Six
# services died with 203/EXEC before anyone worked that out. Half a virtualenv
# in version control is worse than none.
.venv*/
__pycache__/
*.pyc
.pytest_cache/
*.json.tmp
*.jsonl.tmp
.env
.claude/worktrees/
fleet/logs/
fleet/index.html
fleet/workers/
fleet/events.jsonl
fleet/uploads/
fleet/digests/
self-improve/logs/
self-improve/state/observations.json
self-improve/dashboard.html
fleet/proposals/
# `fleet/static/*`, not `fleet/static/` — git will not descend into an excluded
# directory, so a negation inside one never fires.
fleet/static/*
# ...except our own. The rule above exists for vendored xterm builds, which are
# large and replaceable. signature.js is source: it is the projector, and it has
# to stay byte-identical to the copy the entropy pad runs or a human's mark and
# an agent's stop being comparable.
!fleet/static/signature.js
# Also source: a written page about what the fleet did, not a vendored build.
!fleet/static/progress.html
fleet/council/

# NOT hidden for secrecy — the rules live in app/triage.py and are public. This
# optional file is where a specific abusive string or URL goes once someone has
# actually sent one, and committing those would republish them.
data/triage_patterns.json

# Minted credentials and live pairing invites. Never committed.
data/node_secrets.json
data/pairing.json
fleet/data/indexnow-key.txt

# vendored assets stay out — but the gallery ships with the house
!fleet/static/artwork.png
!fleet/static/artwork-full.jpg
fleet/data/signatures-collected.jsonl
fleet/data/selfies.jsonl
fleet/data/localvoice.jsonl
fleet/data/homies-real.txt
# local: absolute paths of this machine's checkouts
fleet/projects.txt
!fleet/static/gallery/
!fleet/static/gallery/*

# local: names the reachable host — not for the repo
.live

# runtime state — written by the running fleet, never release source (#6/#8)
data/pairing.json
data/sync_conflicts.json
data/oplog/
data/inbox/
fleet/rota/
fleet/state/
self-improve/state/
fleet/data/board-name.txt

# Per-install salt for the charge tally. Not a credential, but committing it
# would make the hashed hands comparable across installs, which is exactly what
# the salt exists to prevent.
fleet/data/.charge-salt
