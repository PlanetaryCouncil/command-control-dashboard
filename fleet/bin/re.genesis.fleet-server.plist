<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>re.genesis.fleet-server</string>

    <key>ProgramArguments</key>
    <array>
        <!-- The project venv, not system python: the legacy cockpit now runs
             in-process and needs uvicorn + fastapi. -->
        <string>/path/to/command-control-dashboard/.venv/bin/python3</string>
        <string>/path/to/command-control-dashboard/fleet/bin/fleet.py</string>
        <string>serve</string>
        <string>8787</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/command-control-dashboard/fleet</string>

    <!-- launchd's default PATH misses ~/.local/bin and the node prefix, so
         chat subprocesses (claude, hermes, openclaw) would fail with ENOENT. -->
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Private state, deliberately outside the public repo: the
             guest book's home-IP prefixes and the raw signature paths. -->
        <key>FLEET_HOMIES</key>
        <string>/Users/YOU/.config/fleet/homies.txt</string>
        <key>FLEET_SIGNATURES</key>
        <string>/Users/YOU/.config/fleet/signatures-collected.jsonl</string>
        <key>PATH</key>
        <string>/Users/YOU/.local/bin:/usr/local/opt/node@22/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Always on: start at login, restart if it ever exits. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/path/to/command-control-dashboard/fleet/logs/server.out.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/command-control-dashboard/fleet/logs/server.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
