<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>re.genesis.watchdogs</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/path/to/command-control-dashboard/fleet/bin/run-watchdogs.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/command-control-dashboard/fleet</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/YOU/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Hourly. Cheap (~1s per project), so the board is never stale. -->
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/path/to/command-control-dashboard/fleet/logs/watchdogs.out.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/command-control-dashboard/fleet/logs/watchdogs.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
