<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>re.genesis.self-improve</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/path/to/command-control-dashboard/self-improve/loop/run-cycle.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/command-control-dashboard/self-improve</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/YOU/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>WINDOW_DAYS</key>
        <string>14</string>
        <key>TIMEOUT_SECS</key>
        <string>1800</string>
    </dict>

    <!-- Daily at 03:00. If the Mac is asleep, launchd runs it at next wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/path/to/command-control-dashboard/self-improve/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/command-control-dashboard/self-improve/logs/launchd.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
